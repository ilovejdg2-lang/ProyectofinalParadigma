# Copia este archivo a .env.local.
# No pongas contraseñas ni tokens en este archivo.
# El canal real es /canal. El JWT no se agrega a la URL:
# el frontend lo envía en Sec-WebSocket-Protocol.

VITE_AUTH_URL=http://localhost:5001
VITE_ACTIVIDADES_URL=http://localhost:5002
VITE_CANAL_URL=ws://localhost:5002/canal
VITE_USAR_SIMULACION=false
