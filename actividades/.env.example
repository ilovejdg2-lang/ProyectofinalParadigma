# Copia este archivo a .env y reemplaza los valores de ejemplo.
# No pongas este .env en el repositorio ni pegues las contraseñas en el chat.
#
# En Supabase: Connect → ORM → Prisma.
# DATABASE_URL es el transaction pooler (puerto 6543). Esta fase no lo usa
# para NestJS: un servidor de larga duración encaja con el session pooler.
# DIRECT_URL es el session pooler (puerto 5432). Lo usan Prisma Migrate,
# el seed y el proceso de NestJS.

DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require"

# Mismo puerto que VITE_ACTIVIDADES_URL del frontend.
PORT=5002
FRONTEND_URL="http://localhost:5173"

# Storage público de imágenes. Estas credenciales solo viven en este backend.
# La clave secreta moderna va solo en apikey; el JWT válido de servicio,
# solo en Authorization: Bearer. Son credenciales distintas.
# Si el JWT de servicio no está configurado, el API guarda las imágenes en
# disco (almacen-imagenes/) y las publica en /archivos.
# PUBLIC_API_URL es la dirección que ven los otros dispositivos de la clase.
# En la red local no uses 127.0.0.1: un teléfono no puede abrir el localhost del docente.
PUBLIC_API_URL="http://127.0.0.1:5002"
ALMACEN_IMAGENES_DIR="almacen-imagenes"
SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_SECRET_KEY="replace-me"
SUPABASE_SERVICE_ROLE_JWT="replace-with-valid-service-role-jwt"
SUPABASE_STORAGE_BUCKET="profelink-imagenes"
