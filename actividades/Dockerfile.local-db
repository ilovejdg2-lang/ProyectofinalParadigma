# Solo para la base local de docker-compose.local.yml.
# La imagen de producción sigue siendo Dockerfile y no ejecuta migraciones al arrancar.
FROM node:22-alpine

WORKDIR /app

COPY package.json package-lock.json ./
COPY prisma.config.ts ./
COPY prisma ./prisma
COPY src ./src

# El lockfile lo resolvió npm 11.21.2. npm 10, el de node:22-alpine, lo rechaza.
RUN npm install -g npm@11.21.2 && npm ci

CMD ["sh", "-c", "npx prisma migrate deploy && npx prisma db seed"]
