# Solo para la base local de docker-compose.local.yml.
# La imagen de producción sigue siendo Dockerfile y no ejecuta migraciones al arrancar.
FROM node:22-alpine

WORKDIR /app

COPY package.json package-lock.json ./
COPY prisma.config.ts ./
COPY prisma ./prisma

# Misma razón que el Dockerfile de producción: npm ci exige npm 11.
RUN npm install -g npm@11.21.2 && npm ci

CMD ["npx", "prisma", "migrate", "deploy"]
