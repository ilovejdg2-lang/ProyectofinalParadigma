# Plantilla de la instalación local. No pongas aquí una contraseña real.
# scripts/iniciar.ps1 y scripts/iniciar.sh crean .local/entorno.env
# con LOCAL_DB_PASSWORD generada y ese archivo queda fuera de Git.
#
# Esta instalación no usa Supabase. La producción sigue leyendo
# autenticacion/.env y actividades/.env en el servidor.

LOCAL_DB_PASSWORD=generada-por-el-script
